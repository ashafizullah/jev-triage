{
  "name": "jev-triage",
  "version": "0.1.0",
  "private": true,
  "description": "Automated issue & PR triage for open-source maintainers, powered by Jev (TypeSafe AI).",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsup",
    "start": "node dist/index.js",
    "dev": "tsx watch src/dev.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "triage": "tsx scripts/triage-once.ts",
    "report": "tsx scripts/report.ts"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0",
    "better-sqlite3": "^11.10.0",
    "drizzle-orm": "^0.45.2",
    "pino": "^9.6.0",
    "probot": "^14.3.2",
    "yaml": "^2.7.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.5",
    "drizzle-kit": "^0.31.10",
    "smee-client": "^5.0.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.4"
    }
  }
}
