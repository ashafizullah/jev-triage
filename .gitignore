# --- Dependencies and build output ---
node_modules/
dist/
coverage/
*.tsbuildinfo

# --- Secrets. Never commit these. ---
# The template stays tracked; every real env file is ignored.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.crt
id_rsa*
id_ed25519*

# --- Local runtime data ---
data/
*.db
*.db-journal
*.db-wal
*.db-shm

# Reports contain issue numbers and decision details from the repositories we triage.
reports/

# Generated by `npm run db:generate`; the runtime applies its own DDL on boot.
drizzle/

# --- Logs ---
*.log
npm-debug.log*

# --- Personal agent configuration (not project code) ---
.commandcode/

# --- Local project notes, deliberately not part of the repository ---
jev-triage-build-instructions.md

# --- Editor / OS ---
.DS_Store
.idea/
.vscode/
