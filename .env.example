# Copy to .env and fill in. Run `npm run dev` with APP_ID empty and open
# http://localhost:3000 — Probot's setup wizard creates the GitHub App and fills in
# every GitHub value below (including a smee channel) for you.
#
# Lines commented out with `#` are optional; the ones shown with `=` are the ones you
# normally set. Anything left unset falls back to the default noted next to it.

# --- Jev (TypeSafe AI) ---
# Required. Get a key at https://console.typesafe.ai/keys
TYPESAFE_API_KEY=
# Model name. Default: jev-latest
# Precedence: `model:` in .github/jev-triage.yml > this variable > jev-latest.
# Pin a concrete version (e.g. jev-1.13.0) in production if your thresholds are sensitive.
# Note: the SDK's own TYPESAFE_DEFAULT_MODEL has no effect here, because every request
# sends an explicit model — use JEV_MODEL instead.
JEV_MODEL=

# --- GitHub App ---
# Filled in by the setup wizard. See the app's settings page if you configure it by hand.
APP_ID=
WEBHOOK_SECRET=development
# Contents of the private key. Probot also auto-loads a *.pem file in the project root.
PRIVATE_KEY=
# The setup wizard also writes these two, because GitHub always returns them when it
# converts a manifest code. jev-triage does not read them: they belong to a user-to-server
# OAuth flow ("Sign in with GitHub"), which this app does not implement. Safe to delete.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# --- Server and webhooks ---
# The setup wizard writes a smee.io channel here so GitHub can reach localhost.
# For a stable URL, create your own channel at https://smee.io and paste it here.
WEBHOOK_PROXY_URL=
# Path Probot serves webhooks on. Default: /api/github/webhooks
# WEBHOOK_PATH=
LOG_LEVEL=info
# Default: json in production, pretty otherwise. Set to force one.
# LOG_FORMAT=
PORT=3000
# Leave unset locally (Probot binds localhost). Containers set this to 0.0.0.0.
HOST=

# --- jev-triage runtime ---
# Deployment-wide safety switch. When truthy, NOTHING is written to GitHub, whatever a
# repository's .github/jev-triage.yml says (and even if the CLI passes --apply).
JEV_TRIAGE_DRY_RUN=false
# Where the SQLite database lives. Default: data/jev-triage.db
JEV_TRIAGE_DB_PATH=

# --- Notifications (optional) ---
# Any subset works; whichever are set will be used. A failing destination never fails
# triage, and which findings notify is set per repository by `notify.on`.
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=

# Telegram needs BOTH values: create a bot with @BotFather, then message it and press
# Start before it can reply — a bot cannot open a conversation (the chat id is the user
# id for a private chat, or a negative group id).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Only for a self-hosted Bot API server. Default: https://api.telegram.org
# TELEGRAM_API_BASE=

# --- TypeSafe SDK overrides (rarely needed) ---
# Only useful when routing through a gateway or proxy.
# TYPESAFE_BASE_URL=
# Verbosity of the SDK's own client logging: debug | info | warn | error | off. Default: warn
# TYPESAFE_LOG_LEVEL=
